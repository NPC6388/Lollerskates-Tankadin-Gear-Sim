{
  "name": "lollerskates-tankadin-gear-sim",
  "version": "0.1.0",
  "description": "Client-side gear simulator for WoW Classic TBC Anniversary Protection Paladins",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:lua:wasm": "node bin/run-lua-parity.mjs",
    "optimize": "node bin/optimize.mjs",
