# Uncomment and set once the CurseForge project exists (see addon/PUBLISHING.md):
# ## X-Curse-Project-ID: 000000

# Entry (sets the shared namespace + version) must load first.
TankadinGearSim.lua

# Ported sim engine (dependency order: Constants -> Combat -> Evaluate; Weights -> Scoring;
# CharacterData -> Model, which also needs Constants).
engine\Constants.lua
engine\Combat.lua
engine\Evaluate.lua
engine\Weights.lua
engine\Scoring.lua
engine\CharacterData.lua
engine\Model.lua
engine\ItemsData.lua
engine\Items.lua

# Gem/enchant solver (Phase D4): data tables then hand-ported logic. GemSolver needs Gems + Enchants
# (picks) and Model + Evaluate + Scoring (the at-cap weight switch); Items.build uses Librams lazily.
engine\GemsData.lua
engine\Gems.lua
engine\EnchantsData.lua
engine\Enchants.lua
engine\ProfessionsData.lua
engine\Professions.lua
engine\LibramsData.lua
engine\Librams.lua
engine\ScrollsData.lua
engine\Scrolls.lua
engine\GemSolver.lua

# Optimizer search (Phase D5a): tier-set data + logic, then the pool builder / heuristic / exhaustive
# solver. Needs Model + Evaluate + Scoring + Sets (objective + gates).
engine\SetsData.lua
engine\Sets.lua
engine\Optimizer.lua

# Four-set orchestration (Phase D5b): item variants -> search -> gemming -> gate recovery / reclaim /
# meta-repair / near-alts. Ties together Optimizer + GemSolver + Gems/Enchants + Model/Evaluate + the rest.
engine\Runner.lua

# Website exporter (reads ns.VERSION) and the live-sheet reader.
Exporter.lua
Core.lua

# Live optimizer input: owned gear -> engine/Items objects (needs Exporter + engine.Items).
ItemPool.lua

# Async search driver (Phase D5c): runs engine.Runner.optimizeSets across frames via a coroutine +
# time-budgeted ticker, so a full solve doesn't hitch the client. Impure (CreateFrame/OnUpdate).
AsyncSearch.lua

# UI last (consumes ns.Core + ns.Exporter).
UI.lua

# Minimap button — ItemRack-style flyout of the optimizer's sets (consumes ns.UI + the Optimize results).
Minimap.lua
