#!/bin/sh
# Re-stamp asset cache-busting hashes before each commit so a deploy is never masked by a stale
# browser cache. The stamp fingerprints the entry assets (web/app.js, web/style.css) AND every ES
# module they import (all of src/ + web/*.js, via the index.html import map) — so re-stamp whenever any
# served JS/CSS under src/ or web/ is part of this commit. Commits that touch neither are untouched.
if git diff --cached --name-only | grep -qE '^(src|web)/.*\.(js|css)$'; then
  node bin/stamp.mjs || exit 1
  git add index.html
fi

# Keep the addon's generated data (Constants/Weights/CharacterData/ItemsData + the D4 solver data:
# Gems/Enchants/Professions/Librams/Scrolls) in lockstep with the JS source of truth. Re-run the
# generator whenever any source it reads — or the generator itself — is part of this commit, and stage
# the result. Same spirit as the asset stamp.
if git diff --cached --name-only | grep -qE '^(src/(constants|weights|model|import|gems|enchants|professions|librams|scrolls)\.js|bin/gen-lua-data\.mjs)$'; then
  node bin/gen-lua-data.mjs || exit 1
  git add addon/TankadinGearSim/engine/Constants.lua addon/TankadinGearSim/engine/Weights.lua \
    addon/TankadinGearSim/engine/CharacterData.lua addon/TankadinGearSim/engine/ItemsData.lua \
    addon/TankadinGearSim/engine/GemsData.lua addon/TankadinGearSim/engine/EnchantsData.lua \
    addon/TankadinGearSim/engine/ProfessionsData.lua addon/TankadinGearSim/engine/LibramsData.lua \
    addon/TankadinGearSim/engine/ScrollsData.lua
fi

# Keep the Lua scoring parity goldens fresh when the scoring core (or its generator) changes.
if git diff --cached --name-only | grep -qE '^(src/weights\.js|src/scoring\.js|bin/gen-scoring-fixtures\.mjs)$'; then
  node bin/gen-scoring-fixtures.mjs || exit 1
  git add test/lua/scoring_fixtures.lua
fi

# Keep the Lua forward-model parity goldens fresh when the model (or its generator) changes.
if git diff --cached --name-only | grep -qE '^(src/model\.js|bin/gen-model-fixtures\.mjs)$'; then
  node bin/gen-model-fixtures.mjs || exit 1
  git add test/lua/model_fixtures.lua
fi

# Keep the Lua item-builder parity goldens fresh when import.js — or librams.js (Items.build now applies
# the libram override) — or its generator changes.
if git diff --cached --name-only | grep -qE '^(src/(import|librams)\.js|bin/gen-items-fixtures\.mjs)$'; then
  node bin/gen-items-fixtures.mjs || exit 1
  git add test/lua/items_fixtures.lua
fi

# Keep the Lua gem/enchant solver parity goldens fresh when any solver source (or its generator) changes.
if git diff --cached --name-only | grep -qE '^(src/(gems|enchants|professions|librams|scrolls|gemsolver|weights|scoring|model|character)\.js|bin/gen-solver-fixtures\.mjs)$'; then
  node bin/gen-solver-fixtures.mjs || exit 1
  git add test/lua/solver_fixtures.lua
fi
